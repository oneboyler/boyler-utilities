// icons: 1 = dark tile (also the exe's icon), 2 = light tile (light taskbar)
1 ICON "assets/pane_dark.ico"
2 ICON "assets/pane_light.ico"
1 24 "app.manifest"

// the name Windows shows (Task Manager, the file's properties); the version comes from Cargo.toml: build.rs writes version.h
#include "version.h"
1 VERSIONINFO
FILEVERSION BU_VER_COMMA
PRODUCTVERSION BU_VER_COMMA
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Boyler Utilities"
      VALUE "ProductName", "Boyler Utilities"
      VALUE "OriginalFilename", "Boyler Utilities.exe"
      VALUE "FileVersion", BU_VER_STR
      VALUE "ProductVersion", BU_VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
